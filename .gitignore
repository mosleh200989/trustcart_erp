*.pid.lock

# Misc
coverage
.nyc_output

frontend/node_modules
frontend/.next
backend/node_modules
backend/dist
backend/.env
backend\.env
backend/*.env
backend/*.env.local
backend/uploads/
backend\uploads\


# Database dumps and backups (keep these out of the working tree;
# the VPS checkout must stay byte-identical to the repo)
*.dump
*.sql.gz
.env.backup
*.env.bak*
# Timestamped copies made before editing .env on the server, e.g.
# backend/.env.backup-20260827-192456. Without the trailing wildcard these
# showed up as untracked rather than ignored, so a single `git add -A` on the
# VPS would have committed every production secret.
.env.backup*
*.env.backup*
.env.*.backup*
vps-local-changes-backup.patch

# Process / run artifacts that accumulate on the server
nohup.out
migration-result.json

# TypeScript incremental build cache - regenerated by every build,
# so tracking it guarantees drift between checkouts
frontend/tsconfig.tsbuildinfo

# Claude Code local tooling
.claude/
