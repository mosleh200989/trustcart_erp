# Local development overrides for the Next.js frontend.
#
# Copy to .env.local for local dev:  cp .env.local.example .env.local
#
# .env.local is gitignored and takes precedence over .env, so it is the
# right place for per-machine settings. Do NOT commit it: it was tracked
# historically, which made every deploy fight the production override.
#
# Production needs no .env.local at all — the committed .env already
# points at the live API.

NEXT_PUBLIC_API_URL=http://localhost:3001/api
